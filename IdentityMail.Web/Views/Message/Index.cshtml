
@model List<UserMessage>
@{
    ViewData["Title"] = "Index";
}

<h1>Merhaba, @ViewBag.fullName</h1>

<h3>Gelen mesajlar</h3>

<table class="table table-bordered table-hover">

    <tr>
        <th>Gönder Ad soyad</th>
        <th>Email</th>
        <th>Konu</th>
        <th>Tarih</th>
        <th>İşlemler</th>
    </tr>
    
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Sender.FirstName @item.Sender.LastName</td>
            <td>@item.Sender.Email</td>
            <td>@item.Subject</td>
            <td>@item.SendDate</td>
            <td>

                <a href="/message/maildetail/@item.Id" class="btn btn-outline-info" >Meail i Görüntüle</a>
                <a href="#" class="btn btn-outline-danger">Sil</a>

            </td>
        </tr>
    }


</table>

<a href="/Message/SendMail" class="btn btn-outline-dark">Yeni Mail Gönder</a>

